# Greyshades Innovations - Media Platform Environment Config
APP_NAME="Greyshades Media Platform"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost
APP_KEY=change-me-to-a-32-char-random-string

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=greyshades_media
DB_USER=root
DB_PASS=

# Storage (private path OUTSIDE public dir if possible)
STORAGE_PATH=/var/www/greyshades/storage
UPLOAD_MAX_MB=2048

# Media tooling
FFMPEG_BIN=/usr/bin/ffmpeg
FFPROBE_BIN=/usr/bin/ffprobe
IMAGEMAGICK_BIN=/usr/bin/convert
LIBREOFFICE_BIN=/usr/bin/libreoffice

# Security
SESSION_LIFETIME_MIN=120
STREAM_TOKEN_TTL_MIN=15
ENABLE_WATERMARK=true
ENABLE_ANTI_INSPECT=true
